{
  "name": "karabiner-config",
  "description": "Karabiner-Elements rules and OmniWM workspaces, written with karabiner.ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run check && npm run helper && node src/index.ts",
    "check": "tsc",
    "helper": "go -C ../omniwm/helper vet && go -C ../omniwm/helper build -trimpath -ldflags='-s -w' -o omniwm-helper .",
    "update": "npm update"
  },
  "dependencies": {
    "karabiner.ts": "^1.38.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
